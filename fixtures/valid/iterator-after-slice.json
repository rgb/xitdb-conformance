      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 3 } }] }
    ] } }] },
    { "op": "write_path", "on": "root", "path": ["array_list_init", { "array_list_slice": { "size": 2 } }] },
    { "op": "count", "on": "root", "expect": 2 },
    { "op": "iterator", "on": "root", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 0 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "write", "on": "root", "data": { "slot": null } },
    { "op": "write_path", "on": "root", "path": ["array_list_init", { "ctx": { "as": "l", "ops": [
      { "op": "write_path", "on": "l", "path": ["array_list_append"], "note": "never written" },
      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "l", "path": ["array_list_append", { "write": { "uint": 3 } }] }
    ] } }] },
    { "op": "write_path", "on": "root", "path": ["array_list_init", { "array_list_slice": { "size": 2 } }] },
